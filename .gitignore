.vercel/
.netlify/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp

# dev-recorded landmark dumps (keep curated fixtures in tests/fixtures/)
recordings/
